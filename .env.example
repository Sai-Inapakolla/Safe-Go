# ==============================================================================
# SafeGo - Unified Environment Variables Template
# Copy this file to .env and fill in the values for your local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# ⚙️ Backend Core Configuration (FastAPI & Security)
# ------------------------------------------------------------------------------
APP_NAME=SafeGo
DEBUG=True
DATABASE_URL=mongodb://localhost:27017/safego_db
SECRET_KEY=your-secret-key-minimum-32-characters-long-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 👤 Default Admin & Tester Credentials
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@safego.ph
ADMIN_PASSWORD=Admin@SafeGo2025
ADMIN_PHONE=+919490969706

TESTER_EMAIL=tester@safego.in
TESTER_PASSWORD=Tester@SafeGo2025
TESTER_PHONE=+919490969706

# ------------------------------------------------------------------------------
# 🗺️ Navigation & Geolocation Services
# ------------------------------------------------------------------------------
OSRM_BASE_URL=http://router.project-osrm.org

# ------------------------------------------------------------------------------
# 🚨 Twilio Emergency SMS & Voice Dispatch
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000

# ------------------------------------------------------------------------------
# ☁️ Cloudinary Storage (Driver Document Verification)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=
CLOUDINARY_FOLDER=safego/driver_documents

# ------------------------------------------------------------------------------
# 🤖 AI & Translation Services
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_LANGUAGE=en-IN
