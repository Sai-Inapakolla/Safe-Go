    subgraph Booking_Subsystem ["Ride Booking & Safety AI Engine"]
        UC_SelectMode(["UC-09: Select Mode & Enter Route"])
        UC_PinkPolicy(["UC-10: Check Female Rider Policy"])
        UC_ComputeRoute(["UC-06: Compute OSRM Route"])
        UC_EvalSafety(["UC-07: Predict Safety Class<br/>(Stable / Cautious / High Priority)"])
        UC_ComputeFare(["UC-08: Predict Fare Multiplier<br/>(1.0x - 2.2x Dynamic Surge)"])
        UC_CreateRide(["UC-09b: Lock Fare & Create Ride"])
    end

    Rider --> UC_SelectMode
    PinkRider --> UC_PinkPolicy

    UC_SelectMode -.->|&laquo;include&raquo;| UC_ComputeRoute
    UC_ComputeRoute --- OSRM
    UC_ComputeRoute -.->|&laquo;include&raquo;| UC_EvalSafety
    UC_EvalSafety --- ML_Safety
    UC_EvalSafety -.->|&laquo;include&raquo;| UC_ComputeFare
    UC_ComputeFare --- ML_Surge
    UC_ComputeFare -.->|&laquo;include&raquo;| UC_CreateRide

    UC_PinkPolicy -.->|&laquo;extend&raquo;| UC_SelectMode
```

