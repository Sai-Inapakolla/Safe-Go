    Driver(["🚗 Assigned Driver"])

    subgraph Split_Subsystem ["SafeGo Split Dynamic Co-Riding"]
        UC_EnableSplit(["UC-09c: Rider A Enables Split Mode"])
        UC_DiscoverCorridor(["UC-13: Rider B Searches Matching Active Route"])
        UC_RequestJoin(["UC-14: Rider B Requests to Join Trip"])
        UC_DriverApprove(["UC-15a: Driver Evaluates Corridor Addition"])
        UC_RiderApprove(["UC-15b: Rider A Approves Co-Passenger"])
        UC_IssueSplitPIN(["UC-16a: System Generates Co-Rider OTP"])
        UC_VerifySplitPIN(["UC-16b: Driver Verifies Co-Rider Boarding PIN"])
        UC_ApplySplitSavings(["UC-17: Recalculate Fares, Bonuses & CO₂ Offset"])
    end

    RiderA --> UC_EnableSplit
    RiderB --> UC_DiscoverCorridor
    RiderB --> UC_RequestJoin
    UC_RequestJoin -.->|&laquo;include&raquo;| UC_DriverApprove
    UC_RequestJoin -.->|&laquo;include&raquo;| UC_RiderApprove
    Driver --> UC_DriverApprove
    RiderA --> UC_RiderApprove

    UC_DriverApprove -.->|&laquo;include&raquo;| UC_IssueSplitPIN
    UC_IssueSplitPIN -.->|&laquo;include&raquo;| UC_VerifySplitPIN
    Driver --> UC_VerifySplitPIN
    UC_VerifySplitPIN -.->|&laquo;include&raquo;| UC_ApplySplitSavings
```

